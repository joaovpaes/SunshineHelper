<Window x:Class="SunshineHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="960" Height="600" MinWidth="720" MinHeight="480"
        Background="{DynamicResource Brush.Window}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fixed side navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Band}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="16,24,16,16"
                           Style="{StaticResource Text.Label}"
                           Text="SUNSHINEHELPER" />
                <ListBox x:Name="NavList"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Tag="Panel" Content="{DynamicResource Nav.Panel}" />
                    <ListBoxItem Tag="Profiles" Content="{DynamicResource Nav.Profiles}" />
                    <ListBoxItem Tag="Devices" Content="{DynamicResource Nav.Devices}" />
                    <ListBoxItem Tag="Log" Content="{DynamicResource Nav.Log}" />
                    <ListBoxItem Tag="General" Content="{DynamicResource Nav.General}" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page area. Every screen says in one line what it is for. -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" />
            <TextBlock x:Name="PageDescription" Margin="0,8,0,0" Style="{StaticResource Text.Dim}" />
            <Border x:Name="NotReadyCard" Margin="0,32,0,0" Padding="16"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <TextBlock Style="{StaticResource Text.Dim}" Text="{DynamicResource Page.NotReady}" />
            </Border>

            <!-- Dashboard: what the app is doing right now. -->
            <Border x:Name="PanelCard" Margin="0,32,0,0" Padding="16" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" />
                    <TextBlock x:Name="ClientText" Margin="0,8,0,0" Style="{StaticResource Text.Dim}" />
                    <TextBlock x:Name="ProfileText" Margin="0,4,0,0" Style="{StaticResource Text.Dim}" />
                    <TextBlock x:Name="LogText" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProblemsText" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Profiles: one per device; resolution, HDR and FPS limit. -->
            <Border x:Name="ProfilesCard" Margin="0,32,0,0" Padding="16" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <ListBox x:Name="ProfileList" Height="110" SelectionChanged="OnProfileSelected" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Padding="12,6" Style="{StaticResource Button.Secondary}"
                                Content="{DynamicResource Profiles.New}" Click="OnNewProfile" />
                        <Button x:Name="DeleteProfileButton" Margin="8,0,0,0" Padding="12,6"
                                Style="{StaticResource Button.Secondary}"
                                Content="{DynamicResource Profiles.Delete}" Click="OnDeleteProfile" />
                    </StackPanel>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource Profiles.Name}" />
                    <TextBox x:Name="ProfileNameBox" Margin="0,8,0,0" Padding="6,4" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource Profiles.ClientNames}" />
                    <TextBox x:Name="ProfileClientsBox" Margin="0,8,0,0" Padding="6,4" Height="60"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource Profiles.ClientNames.Hint}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource Profiles.Resolution}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="ResolutionModeBox" Width="200" SelectionChanged="OnProfileModeChanged">
                                                        <ComboBoxItem Tag="FollowClient" Content="{DynamicResource Profiles.Mode.Follow}" />
                            <ComboBoxItem Tag="Fixed" Content="{DynamicResource Profiles.Mode.Fixed}" />
                            <ComboBoxItem Tag="Leave" Content="{DynamicResource Profiles.Mode.Leave}" />
                        </ComboBox>
                        <TextBox x:Name="ResolutionBox" Margin="8,0,0,0" Width="140" Padding="6,4" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" Text="{DynamicResource Profiles.Resolution.Hint}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="HDR" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="HdrModeBox" Width="200" SelectionChanged="OnProfileModeChanged">
                                                        <ComboBoxItem Tag="FollowClient" Content="{DynamicResource Profiles.Mode.Follow}" />
                            <ComboBoxItem Tag="Fixed" Content="{DynamicResource Profiles.Mode.Fixed}" />
                            <ComboBoxItem Tag="Leave" Content="{DynamicResource Profiles.Mode.Leave}" />
                        </ComboBox>
                        <CheckBox x:Name="HdrOnBox" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Content="{DynamicResource Profiles.Hdr.On}" />
                    </StackPanel>

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource Profiles.Fps}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ComboBox x:Name="FpsModeBox" Width="200" SelectionChanged="OnProfileModeChanged">
                                                        <ComboBoxItem Tag="FollowClient" Content="{DynamicResource Profiles.Mode.Follow}" />
                            <ComboBoxItem Tag="Fixed" Content="{DynamicResource Profiles.Mode.Fixed}" />
                            <ComboBoxItem Tag="Leave" Content="{DynamicResource Profiles.Mode.Leave}" />
                        </ComboBox>
                        <TextBox x:Name="FpsBox" Margin="8,0,0,0" Width="80" Padding="6,4" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="RevertOnDisconnectBox" Margin="0,16,0,0"
                              Content="{DynamicResource Profiles.Revert}" />
                    <CheckBox x:Name="DefaultProfileBox" Margin="0,8,0,0"
                              Content="{DynamicResource Profiles.Default}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource Profiles.Delay}" />
                    <TextBox x:Name="ProfileDelayBox" Margin="0,8,0,0" Width="120" Padding="6,4" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource Profiles.Delay.Hint}" />

                    <Button Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Primary}"
                            Content="{DynamicResource Profiles.Save}" Click="OnSaveProfile" />
                    <TextBlock x:Name="ProfilesMessage" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- General: language and the Sunshine log path. -->
            <Border x:Name="GeneralCard" Margin="0,32,0,0" Padding="16" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource General.Language}" />
                    <ComboBox x:Name="LanguageBox" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Tag="" Content="{DynamicResource General.Language.System}" />
                        <ComboBoxItem Tag="pt-BR" Content="Português" />
                        <ComboBoxItem Tag="en" Content="English" />
                    </ComboBox>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource General.LogPath}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"
                                Style="{StaticResource Button.Secondary}"
                                Content="{DynamicResource General.Browse}" Click="OnBrowseLog" />
                        <TextBox x:Name="LogPathBox" VerticalContentAlignment="Center" Padding="6,4" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource General.LogPath.Hint}" />
                    <Button Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Primary}"
                            Content="{DynamicResource General.Save}" Click="OnSaveLogPath" />

                    <Border Margin="0,24,0,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" />
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource General.Launcher}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource General.Launcher.Hint}" />
                    <TextBox x:Name="LauncherNamesBox" Margin="0,8,0,0" Padding="6,4" Height="72"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource General.Launcher.Delay}" />
                    <TextBox x:Name="LauncherDelayBox" Margin="0,8,0,0" Padding="6,4" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource General.Launcher.Delay.Hint}" />
                    <Button Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Primary}"
                            Content="{DynamicResource General.Save}" Click="OnSaveLauncher" />

                    <TextBlock x:Name="GeneralMessage" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
