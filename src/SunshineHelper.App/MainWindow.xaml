<Window x:Class="SunshineHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="960" Height="600" MinWidth="720" MinHeight="480"
        Background="{DynamicResource Brush.Window}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fixed side navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Band}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="16,24,16,16"
                           Style="{StaticResource Text.Label}"
                           Text="SUNSHINEHELPER" />
                <ListBox x:Name="NavList"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Tag="Panel" Content="{DynamicResource Nav.Panel}" />
                    <ListBoxItem Tag="Profiles" Content="{DynamicResource Nav.Profiles}" />
                    <ListBoxItem Tag="Devices" Content="{DynamicResource Nav.Devices}" />
                    <ListBoxItem Tag="Log" Content="{DynamicResource Nav.Log}" />
                    <ListBoxItem Tag="General" Content="{DynamicResource Nav.General}" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page area. Every screen says in one line what it is for. -->
        <StackPanel Grid.Column="1" Margin="32">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" />
            <TextBlock x:Name="PageDescription" Margin="0,8,0,0" Style="{StaticResource Text.Dim}" />
            <Border x:Name="NotReadyCard" Margin="0,32,0,0" Padding="16"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <TextBlock Style="{StaticResource Text.Dim}" Text="{DynamicResource Page.NotReady}" />
            </Border>

            <!-- Dashboard: what the app is doing right now. -->
            <Border x:Name="PanelCard" Margin="0,32,0,0" Padding="16" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Body}" />
                    <TextBlock x:Name="ClientText" Margin="0,8,0,0" Style="{StaticResource Text.Dim}" />
                    <TextBlock x:Name="ProfileText" Margin="0,4,0,0" Style="{StaticResource Text.Dim}" />
                    <TextBlock x:Name="LogText" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProblemsText" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- General: language and the Sunshine log path. -->
            <Border x:Name="GeneralCard" Margin="0,32,0,0" Padding="16" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Medium}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="{DynamicResource General.Language}" />
                    <ComboBox x:Name="LanguageBox" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Tag="" Content="{DynamicResource General.Language.System}" />
                        <ComboBoxItem Tag="pt-BR" Content="Português" />
                        <ComboBoxItem Tag="en" Content="English" />
                    </ComboBox>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource Text.Label}" Text="{DynamicResource General.LogPath}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"
                                Style="{StaticResource Button.Secondary}"
                                Content="{DynamicResource General.Browse}" Click="OnBrowseLog" />
                        <TextBox x:Name="LogPathBox" VerticalContentAlignment="Center" Padding="6,4" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap"
                               Text="{DynamicResource General.LogPath.Hint}" />
                    <Button Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Style="{StaticResource Button.Primary}"
                            Content="{DynamicResource General.Save}" Click="OnSaveLogPath" />

                    <TextBlock x:Name="GeneralMessage" Margin="0,16,0,0" Style="{StaticResource Text.Dim}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
