<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- pt-BR. Same keys as Strings.en.xaml; the localization test fails if they drift.
         Tone: a tool, not an assistant — direct, no exclamation marks. -->

    <sys:String x:Key="App.Title">SunshineHelper</sys:String>

    <sys:String x:Key="Nav.Panel">Painel</sys:String>
    <sys:String x:Key="Nav.Profiles">Perfis</sys:String>
    <sys:String x:Key="Nav.Devices">Dispositivos</sys:String>
    <sys:String x:Key="Nav.Log">Log</sys:String>
    <sys:String x:Key="Nav.General">Geral</sys:String>

    <sys:String x:Key="Page.Panel.Title">Painel</sys:String>
    <sys:String x:Key="Page.Panel.Description">Estado da transmissão, aparelho e perfil em uso.</sys:String>
    <sys:String x:Key="Page.Profiles.Title">Perfis</sys:String>
    <sys:String x:Key="Page.Profiles.Description">Resolução, HDR e limite de FPS de cada aparelho.</sys:String>
    <sys:String x:Key="Page.Devices.Title">Dispositivos</sys:String>
    <sys:String x:Key="Page.Devices.Description">Aparelhos que já se conectaram e o perfil de cada um.</sys:String>
    <sys:String x:Key="Page.Log.Title">Log</sys:String>
    <sys:String x:Key="Page.Log.Description">O que o app fez em cada sessão.</sys:String>
    <sys:String x:Key="Page.General.Title">Geral</sys:String>
    <sys:String x:Key="Page.General.Description">Idioma, tema e caminho do log do Sunshine.</sys:String>

    <sys:String x:Key="Page.NotReady">Esta tela chega em um próximo PR.</sys:String>

    <sys:String x:Key="Panel.Status.Idle">Nenhuma transmissão ativa.</sys:String>
    <sys:String x:Key="Panel.Status.Active">Transmissão ativa: o ambiente está modificado.</sys:String>
    <sys:String x:Key="Panel.Status.NeedsAttention">Atenção: não foi possível restaurar o ambiente.</sys:String>
    <sys:String x:Key="Panel.Device">Dispositivo: {0}</sys:String>
    <sys:String x:Key="Panel.Profile">Perfil: {0}</sys:String>
    <sys:String x:Key="Panel.Log.Off">Leitor do log desligado: o caminho do log do Sunshine ainda não foi definido.</sys:String>
    <sys:String x:Key="Panel.Log.On">Leitor do log ativo.</sys:String>
    <sys:String x:Key="Panel.Problems">Problemas ao iniciar:</sys:String>
    <sys:String x:Key="Panel.NotApplied">Aviso: não foi aplicado nesta transmissão: {0}. O resto do perfil está ativo; o motivo está no app.log (ou gere o relatório de diagnóstico na tela Geral).</sys:String>
    <sys:String x:Key="Module.display">Resolução</sys:String>
    <sys:String x:Key="Module.hdr">HDR</sys:String>
    <sys:String x:Key="Module.fps">Limite de FPS</sys:String>
    <sys:String x:Key="Module.launcher">Fechar o launcher</sys:String>

    <sys:String x:Key="Tray.Open">Abrir</sys:String>
    <sys:String x:Key="Tray.Exit">Sair</sys:String>

    <sys:String x:Key="General.Language">Idioma</sys:String>
    <sys:String x:Key="General.Language.System">Seguir o Windows</sys:String>
    <sys:String x:Key="General.Startup">Iniciar com o Windows, minimizado na bandeja</sys:String>
    <sys:String x:Key="General.Startup.Hint">O app abre sozinho quando você entra no Windows e fica na bandeja, pronto antes de você iniciar uma transmissão. Também dá para desligar em Configurações do Windows, Aplicativos, Inicializar. Abrir à mão continua mostrando a janela.</sys:String>
    <sys:String x:Key="General.Startup.On">O app agora vai iniciar com o Windows.</sys:String>
    <sys:String x:Key="General.Startup.Off">O app não vai mais iniciar com o Windows.</sys:String>
    <sys:String x:Key="General.Startup.NoPath">Não foi possível descobrir onde o app está instalado.</sys:String>
    <sys:String x:Key="General.Startup.Failed">Não foi possível alterar a opção: {0}</sys:String>
    <sys:String x:Key="General.LogPath">Arquivo de log do Sunshine</sys:String>
    <sys:String x:Key="General.LogPath.Hint">Caminho completo do sunshine.log. Deixe vazio para desligar o leitor do log (retomar e desconexão simples deixam de ser detectadas).</sys:String>
    <sys:String x:Key="General.Browse">Procurar...</sys:String>
    <sys:String x:Key="General.Save">Salvar</sys:String>
    <sys:String x:Key="General.Saved">Salvo. O leitor do log já usa o novo caminho.</sys:String>
    <sys:String x:Key="General.SavedOff">Salvo. O leitor do log está desligado.</sys:String>
    <sys:String x:Key="General.PathInvalid">Caminho inválido: use o caminho completo, com a letra do disco (por exemplo C:\...\sunshine.log).</sys:String>
    <sys:String x:Key="General.SaveFailed">Não foi possível salvar o settings.json: {0}</sys:String>
    <sys:String x:Key="Panel.Log.LowLevel">Atenção: o log do Sunshine parece estar num nível baixo demais e não mostra o fim da transmissão. No Sunshine, em Configuração > Geral, ajuste o nível de log mínimo para Debug (e reinicie o Sunshine). O app não muda isso sozinho.</sys:String>

    <sys:String x:Key="General.Launcher">Programas a fechar no fim da transmissão</sys:String>
    <sys:String x:Key="General.Launcher.Hint">Nomes dos processos, um por linha, como aparecem no Gerenciador de Tarefas (por exemplo Playnite.FullscreenApp). Só são fechados os que abriram durante a transmissão; o que você já tinha aberto antes nunca é fechado. Vazio: o app não fecha nada.</sys:String>
    <sys:String x:Key="General.Launcher.Delay">Atraso antes de abrir o launcher (milissegundos)</sys:String>
    <sys:String x:Key="General.Launcher.Delay.Hint">0 a 30000. Deixe em 0 se o launcher já fecha direito. A mudança vale a partir da próxima transmissão.</sys:String>
    <sys:String x:Key="General.Launcher.Saved">Salvo. Vale a partir da próxima transmissão.</sys:String>
    <sys:String x:Key="General.Launcher.DelayInvalid">Atraso inválido: use um número inteiro de 0 a 30000.</sys:String>

    <sys:String x:Key="General.Report">Relatório de diagnóstico</sys:String>
    <sys:String x:Key="General.Report.Hint">Descreva o problema com suas palavras (o que você fez, o que esperava e o que aconteceu). O botão junta isso com suas configurações e o fim dos logs num arquivo de texto, que você escolhe onde salvar. Endereços IP e MAC, chaves do Sunshine e o seu nome de usuário do Windows são trocados por marcadores. Nada é enviado pela internet: leia o arquivo antes de compartilhar.</sys:String>
    <sys:String x:Key="General.Report.Generate">Gerar relatório de diagnóstico</sys:String>
    <sys:String x:Key="General.Report.Saved">Relatório salvo em {0}</sys:String>
    <sys:String x:Key="General.Report.Failed">Não foi possível salvar o relatório: {0}</sys:String>
    <sys:String x:Key="General.About">Sobre</sys:String>
    <sys:String x:Key="General.About.Version">Versão {0}</sys:String>
    <sys:String x:Key="Profiles.New">Novo perfil</sys:String>
    <sys:String x:Key="Profiles.Delete">Excluir</sys:String>
    <sys:String x:Key="Profiles.Save">Salvar perfil</sys:String>
    <sys:String x:Key="Profiles.NewItem">(novo perfil)</sys:String>
    <sys:String x:Key="Profiles.Name">Nome do perfil</sys:String>
    <sys:String x:Key="Profiles.ClientNames">Nomes dos dispositivos (Moonlight)</sys:String>
    <sys:String x:Key="Profiles.ClientNames.Hint">Um por linha, como aparece no Moonlight. Deixe vazio para um perfil que só vale como padrão.</sys:String>
    <sys:String x:Key="Profiles.Resolution">Resolução</sys:String>
    <sys:String x:Key="Profiles.Resolution.Hint">Em "Valor fixo", escreva assim: 1920x1080.</sys:String>
    <sys:String x:Key="Profiles.Fps">Limite de FPS</sys:String>
    <sys:String x:Key="Profiles.Mode.Follow">Seguir o dispositivo</sys:String>
    <sys:String x:Key="Profiles.Mode.Fixed">Valor fixo</sys:String>
    <sys:String x:Key="Profiles.Mode.Leave">Deixar como está</sys:String>
    <sys:String x:Key="Profiles.Hdr.On">HDR ligado (em "Valor fixo")</sys:String>
    <sys:String x:Key="Profiles.Revert">Restaurar a tela ao desconectar (sem encerrar a sessão)</sys:String>
    <sys:String x:Key="Profiles.Default">Usar como perfil padrão (quando nenhum nome bater)</sys:String>
    <sys:String x:Key="Profiles.Delay">Atraso do launcher neste perfil (milissegundos)</sys:String>
    <sys:String x:Key="Profiles.Delay.Hint">Vazio usa o atraso da tela Geral. 0 a 30000.</sys:String>
    <sys:String x:Key="Profiles.Saved">Perfil salvo. Vale a partir da próxima transmissão.</sys:String>
    <sys:String x:Key="Profiles.Deleted">Perfil excluído.</sys:String>
    <sys:String x:Key="Profiles.DeleteConfirm">Excluir o perfil "{0}"? Isso não pode ser desfeito (existe uma cópia de segurança diária do arquivo).</sys:String>
    <sys:String x:Key="Profiles.DeleteTitle">Excluir perfil</sys:String>
    <sys:String x:Key="Profiles.Error.Name">Dê um nome ao perfil.</sys:String>
    <sys:String x:Key="Profiles.Error.Resolution">Resolução inválida: use o formato 1920x1080.</sys:String>
    <sys:String x:Key="Profiles.Error.Fps">FPS inválido: use um número inteiro de 1 a 1000.</sys:String>
    <sys:String x:Key="Profiles.Error.Delay">Atraso inválido: deixe vazio ou use um número inteiro de 0 a 30000.</sys:String>
    <sys:String x:Key="Profiles.Fps.NoPermission">Este perfil limita o FPS, mas o app ainda não tem permissão para gravar o perfil do RTSS (ele fica em Program Files). Clique em "Reparar": o Windows pede confirmação uma vez e libera só esse arquivo.</sys:String>
    <sys:String x:Key="Profiles.Fps.Repair">Reparar</sys:String>
    <sys:String x:Key="Profiles.Fps.Repairing">Aguardando a confirmação do Windows...</sys:String>
    <sys:String x:Key="Profiles.Fps.Repaired">Pronto: o app já pode gravar o limite de FPS do RTSS.</sys:String>
    <sys:String x:Key="Profiles.Fps.RepairFailed">Não foi possível liberar a permissão: {0}</sys:String>
    <sys:String x:Key="Panel.RtssClosed">Aviso: este perfil limita o FPS, mas o RTSS não está aberto. O limite só vale depois que o RTSS abrir.</sys:String>
</ResourceDictionary>
