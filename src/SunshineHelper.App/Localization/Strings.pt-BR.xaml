<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- pt-BR. Same keys as Strings.en.xaml; the localization test fails if they drift.
         Tone: a tool, not an assistant — direct, no exclamation marks. -->

    <x:String x:Key="App.Title">SunshineHelper</x:String>

    <x:String x:Key="Nav.Panel">Painel</x:String>
    <x:String x:Key="Nav.Profiles">Perfis</x:String>
    <x:String x:Key="Nav.Devices">Dispositivos</x:String>
    <x:String x:Key="Nav.Log">Log</x:String>
    <x:String x:Key="Nav.General">Geral</x:String>

    <x:String x:Key="Page.Panel.Title">Painel</x:String>
    <x:String x:Key="Page.Panel.Description">Estado da transmissão, aparelho e perfil em uso.</x:String>
    <x:String x:Key="Page.Profiles.Title">Perfis</x:String>
    <x:String x:Key="Page.Profiles.Description">Resolução, HDR e limite de FPS de cada aparelho.</x:String>
    <x:String x:Key="Page.Devices.Title">Dispositivos</x:String>
    <x:String x:Key="Page.Devices.Description">Aparelhos que já se conectaram e o perfil de cada um.</x:String>
    <x:String x:Key="Page.Log.Title">Log</x:String>
    <x:String x:Key="Page.Log.Description">O que o app fez em cada sessão.</x:String>
    <x:String x:Key="Page.General.Title">Geral</x:String>
    <x:String x:Key="Page.General.Description">Idioma, tema e caminho do log do Sunshine.</x:String>

    <x:String x:Key="Page.NotReady">Esta tela chega em um próximo PR.</x:String>
</ResourceDictionary>
