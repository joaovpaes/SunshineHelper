<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- pt-BR. Same keys as Strings.en.xaml; the localization test fails if they drift.
         Tone: a tool, not an assistant — direct, no exclamation marks. -->

    <sys:String x:Key="App.Title">SunshineHelper</sys:String>

    <sys:String x:Key="Nav.Panel">Painel</sys:String>
    <sys:String x:Key="Nav.Profiles">Perfis</sys:String>
    <sys:String x:Key="Nav.Devices">Dispositivos</sys:String>
    <sys:String x:Key="Nav.Log">Log</sys:String>
    <sys:String x:Key="Nav.General">Geral</sys:String>

    <sys:String x:Key="Page.Panel.Title">Painel</sys:String>
    <sys:String x:Key="Page.Panel.Description">Estado da transmissão, aparelho e perfil em uso.</sys:String>
    <sys:String x:Key="Page.Profiles.Title">Perfis</sys:String>
    <sys:String x:Key="Page.Profiles.Description">Resolução, HDR e limite de FPS de cada aparelho.</sys:String>
    <sys:String x:Key="Page.Devices.Title">Dispositivos</sys:String>
    <sys:String x:Key="Page.Devices.Description">Aparelhos que já se conectaram e o perfil de cada um.</sys:String>
    <sys:String x:Key="Page.Log.Title">Log</sys:String>
    <sys:String x:Key="Page.Log.Description">O que o app fez em cada sessão.</sys:String>
    <sys:String x:Key="Page.General.Title">Geral</sys:String>
    <sys:String x:Key="Page.General.Description">Idioma, tema e caminho do log do Sunshine.</sys:String>

    <sys:String x:Key="Page.NotReady">Esta tela chega em um próximo PR.</sys:String>

    <sys:String x:Key="Panel.Status.Idle">Nenhuma transmissão ativa.</sys:String>
    <sys:String x:Key="Panel.Status.Active">Transmissão ativa: o ambiente está modificado.</sys:String>
    <sys:String x:Key="Panel.Status.NeedsAttention">Atenção: não foi possível restaurar o ambiente.</sys:String>
    <sys:String x:Key="Panel.Device">Dispositivo: {0}</sys:String>
    <sys:String x:Key="Panel.Profile">Perfil: {0}</sys:String>
    <sys:String x:Key="Panel.Log.Off">Leitor do log desligado: o caminho do log do Sunshine ainda não foi definido.</sys:String>
    <sys:String x:Key="Panel.Log.On">Leitor do log ativo.</sys:String>
    <sys:String x:Key="Panel.Problems">Problemas ao iniciar:</sys:String>

    <sys:String x:Key="Tray.Open">Abrir</sys:String>
    <sys:String x:Key="Tray.Exit">Sair</sys:String>

    <sys:String x:Key="General.Language">Idioma</sys:String>
    <sys:String x:Key="General.Language.System">Seguir o Windows</sys:String>
    <sys:String x:Key="General.LogPath">Arquivo de log do Sunshine</sys:String>
    <sys:String x:Key="General.LogPath.Hint">Caminho completo do sunshine.log. Deixe vazio para desligar o leitor do log (retomar e desconexão simples deixam de ser detectadas).</sys:String>
    <sys:String x:Key="General.Browse">Procurar...</sys:String>
    <sys:String x:Key="General.Save">Salvar</sys:String>
    <sys:String x:Key="General.Saved">Salvo. O leitor do log já usa o novo caminho.</sys:String>
    <sys:String x:Key="General.SavedOff">Salvo. O leitor do log está desligado.</sys:String>
    <sys:String x:Key="General.PathInvalid">Caminho inválido: use o caminho completo, com a letra do disco (por exemplo C:\...\sunshine.log).</sys:String>
    <sys:String x:Key="General.SaveFailed">Não foi possível salvar o settings.json: {0}</sys:String>
    <sys:String x:Key="Panel.Log.LowLevel">Atenção: o log do Sunshine parece estar num nível baixo demais e não mostra o fim da transmissão. No Sunshine, em Configuração > Geral, ajuste o nível de log mínimo para Debug (e reinicie o Sunshine). O app não muda isso sozinho.</sys:String>
</ResourceDictionary>
