    <sys:String x:Key="Page.Panel.Title">Dashboard</sys:String>
    <sys:String x:Key="Page.Panel.Description">Stream state, device and profile in use.</sys:String>
    <sys:String x:Key="Page.Profiles.Title">Profiles</sys:String>
    <sys:String x:Key="Page.Profiles.Description">Resolution, HDR and FPS limit for each device.</sys:String>
    <sys:String x:Key="Page.Devices.Title">Devices</sys:String>
    <sys:String x:Key="Page.Devices.Description">Devices that have connected, and the profile for each.</sys:String>
    <sys:String x:Key="Page.Controller.Title">Controller</sys:String>
    <sys:String x:Key="Page.Controller.Description">The combos you hold on the controller, and how long.</sys:String>
    <sys:String x:Key="Page.Log.Title">Log</sys:String>
    <sys:String x:Key="Page.Log.Description">What the app did in each session.</sys:String>
    <sys:String x:Key="Page.General.Title">General</sys:String>
    <sys:String x:Key="Page.General.Description">Language, theme and the Sunshine log path.</sys:String>

    <sys:String x:Key="Page.NotReady">This screen arrives in an upcoming PR.</sys:String>
    <sys:String x:Key="Devices.Hint">Devices that have connected, by the name Moonlight reports. Only the name, the number of connections, the last time and the profile used are kept, on this PC (devices.json). Forgetting a device only deletes that record: profiles are not touched.</sys:String>
    <sys:String x:Key="Devices.Empty">No device has connected yet. They show up here on the first stream.</sys:String>
    <sys:String x:Key="Devices.Item">{0}  ·  connections: {1}  ·  last: {2}  ·  profile: {3}</sys:String>
    <sys:String x:Key="Devices.NoProfile">none matched</sys:String>
    <sys:String x:Key="Devices.Forget">Forget device</sys:String>
    <sys:String x:Key="Devices.Forgotten">Device removed from the list. It shows up again on its next connection.</sys:String>
    <sys:String x:Key="Devices.CreateProfile">Create profile for this device</sys:String>
    <sys:String x:Key="Devices.OpenProfile">Open this device's profile</sys:String>
    <sys:String x:Key="Devices.ProfileDraft">New profile for "{0}": choose the resolution, HDR and FPS limit and click Save profile. Nothing is saved until then.</sys:String>
    <sys:String x:Key="LogView.Hint">The end of the app's own log (app.log): what the app did in each session. It updates by itself. Nothing here is changed or sent anywhere. If you share it, read it first.</sys:String>
    <sys:String x:Key="LogView.OnlyProblems">Show only warnings and errors</sys:String>
    <sys:String x:Key="LogView.Copy">Copy</sys:String>
    <sys:String x:Key="LogView.OpenFolder">Open log folder</sys:String>
    <sys:String x:Key="LogView.Copied">Copied. Read it before sharing it with anyone.</sys:String>
    <sys:String x:Key="LogView.CopyFailed">Could not copy: another program is using the clipboard. Try again.</sys:String>
    <sys:String x:Key="LogView.NoFolder">The log folder does not exist yet. It is created with the first line the app writes.</sys:String>
    <sys:String x:Key="LogView.Unavailable">The log file could not be read (it may not exist yet).</sys:String>

    <sys:String x:Key="Panel.Status.Idle">No active stream.</sys:String>
    <sys:String x:Key="Panel.Status.Active">Stream active: the environment is modified.</sys:String>
    <sys:String x:Key="Panel.Status.NeedsAttention">Attention: the environment could not be restored.</sys:String>
    <sys:String x:Key="Panel.Device">Device: {0}</sys:String>
    <sys:String x:Key="Panel.Profile">Profile: {0}</sys:String>
    <sys:String x:Key="Panel.Log.Off">Log reader off: the Sunshine log path has not been set.</sys:String>
    <sys:String x:Key="Panel.Log.On">Log reader running.</sys:String>
    <sys:String x:Key="Panel.Problems">Problems at startup:</sys:String>
    <sys:String x:Key="Panel.NotApplied">Warning: not applied in this stream: {0}. The rest of the profile is active; the reason is in app.log (or generate the diagnostic report on the General screen).</sys:String>
    <sys:String x:Key="Module.display">Resolution</sys:String>
    <sys:String x:Key="Module.hdr">HDR</sys:String>
    <sys:String x:Key="Module.fps">FPS limit</sys:String>
    <sys:String x:Key="Module.launcher">Close the launcher</sys:String>

    <sys:String x:Key="Tray.Open">Open</sys:String>
    <sys:String x:Key="Tray.Exit">Exit</sys:String>

    <sys:String x:Key="General.Language">Language</sys:String>
    <sys:String x:Key="General.Language.System">Follow Windows</sys:String>
    <sys:String x:Key="General.Startup">Start with Windows, minimized to the tray</sys:String>
    <sys:String x:Key="General.Startup.Hint">The app opens by itself when you sign in to Windows and stays in the tray, ready before you start a stream. You can also turn it off in Windows Settings, Apps, Startup. Opening it by hand still shows the window.</sys:String>
    <sys:String x:Key="General.Startup.On">The app will now start with Windows.</sys:String>
    <sys:String x:Key="General.Startup.Off">The app will no longer start with Windows.</sys:String>
    <sys:String x:Key="General.Startup.NoPath">Could not find where the app is installed.</sys:String>
    <sys:String x:Key="General.Startup.Failed">Could not change the setting: {0}</sys:String>
    <sys:String x:Key="General.LogPath">Sunshine log file</sys:String>
    <sys:String x:Key="General.LogPath.Hint">Full path to sunshine.log. Leave empty to turn the log reader off (resume and plain disconnects are then no longer detected).</sys:String>
    <sys:String x:Key="General.Browse">Browse...</sys:String>
    <sys:String x:Key="General.Save">Save</sys:String>
    <sys:String x:Key="General.Saved">Saved. The log reader is using the new path.</sys:String>
    <sys:String x:Key="General.SavedOff">Saved. The log reader is off.</sys:String>
    <sys:String x:Key="General.PathInvalid">Invalid path: use the full path, with the drive letter (for example C:\...\sunshine.log).</sys:String>
    <sys:String x:Key="General.SaveFailed">Could not save settings.json: {0}</sys:String>
    <sys:String x:Key="Panel.Log.LowLevel">Warning: the Sunshine log looks set to a level too low to show when a stream ends. In Sunshine, under Configuration > General, set the minimum log level to Debug (and restart Sunshine). This app never changes it for you.</sys:String>

    <sys:String x:Key="General.Launcher">Programs to close when the stream ends</sys:String>
    <sys:String x:Key="General.Launcher.Hint">Process names, one per line, as shown in Task Manager (for example Playnite.FullscreenApp). Only the ones opened during the stream are closed; anything you already had open before is never closed. Empty: the app closes nothing.</sys:String>
    <sys:String x:Key="General.Launcher.Delay">Delay before the launcher opens (milliseconds)</sys:String>
    <sys:String x:Key="General.Launcher.Delay.Hint">0 to 30000. Leave at 0 if the launcher already closes properly. Takes effect from the next stream.</sys:String>
    <sys:String x:Key="General.Launcher.Saved">Saved. Takes effect from the next stream.</sys:String>
    <sys:String x:Key="General.Launcher.DelayInvalid">Invalid delay: use a whole number from 0 to 30000.</sys:String>

    <sys:String x:Key="General.CloseGame">Close the game with the controller</sys:String>
    <sys:String x:Key="General.CloseGame.Enable">Close the game in front by holding its combo on the controller (see the Controller screen; Select + Y for 5 seconds by default)</sys:String>
    <sys:String x:Key="General.CloseGame.Hint">Only during a stream. The app first asks the game to close, like clicking its X. If the game does not close, hold the combo again within 15 seconds to end it. It never closes Windows, Sunshine, this app, the launcher or anything you had open before the stream. Needs the Sunshine option gamepad set to x360. Games that run as administrator also need the permission below.</sys:String>
    <sys:String x:Key="General.CloseGame.NoLauncher">The list of programs to close above is empty: without the launcher's name, the combo could close it if it is the program in front.</sys:String>
    <sys:String x:Key="General.CloseGame.Return">Bring the launcher back to the front after closing the game</sys:String>
    <sys:String x:Key="General.CloseGame.Force">End the game without asking for confirmation</sys:String>
    <sys:String x:Key="General.CloseGame.Force.Hint">Off by default. When on, a game that does not close by itself is ended right away, and anything it had not saved is lost.</sys:String>
    <sys:String x:Key="General.CloseGame.On">Closing the game with the controller is on. It takes effect right away, in the current stream too.</sys:String>
    <sys:String x:Key="General.CloseGame.Off">Closing the game with the controller is off.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin">Games that run as administrator</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Hint">Some games only start as administrator, and Windows does not let this app (which runs without administrator) close them. Allowing copies SunshineHelper.Trigger.exe to the Program Files folder and creates a scheduled task that only closes games started by Sunshine that run as administrator. Windows asks for confirmation once; the app keeps running without administrator.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Checking">Checking…</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.NotAllowed">Not allowed.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Allowed">Allowed.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Outdated">Allowed, but the app was updated since. Click Update to use the new version.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.NotAdminAccount">Unavailable: this Windows account is not an administrator.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.AuxiliaryMissing">Unavailable: SunshineHelper.Trigger.exe is not in the app's folder.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.CheckFailed">Could not check: {0}</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Allow">Allow closing administrator games</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Update">Update</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Remove">Remove</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Done.Allowed">Done: allowed.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Done.Removed">Removed: the scheduled task and the copy in Program Files were deleted.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Error">It did not work: {0}</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Canceled">Canceled at the Windows prompt. Nothing changed.</sys:String>
    <sys:String x:Key="General.CloseGame.Admin.Failed">It did not work (code {0}). The codes are in the guide (LEIA-ME), section "Fechar jogos de administrador".</sys:String>

    <sys:String x:Key="General.Report">Diagnostic report</sys:String>
    <sys:String x:Key="General.Report.Hint">Describe the problem in your own words (what you did, what you expected and what happened). The button gathers that with your settings and the end of the logs into a text file you choose where to save. IP and MAC addresses, Sunshine keys and your Windows user name are replaced by placeholders. Nothing is sent over the internet: read the file before sharing it.</sys:String>
    <sys:String x:Key="General.Report.Generate">Generate diagnostic report</sys:String>
    <sys:String x:Key="General.Report.Saved">Report saved to {0}</sys:String>
    <sys:String x:Key="General.Report.Failed">Could not save the report: {0}</sys:String>
    <sys:String x:Key="General.About">About</sys:String>
    <sys:String x:Key="General.About.Version">Version {0}</sys:String>
    <sys:String x:Key="Profiles.New">New profile</sys:String>
    <sys:String x:Key="Profiles.Delete">Delete</sys:String>
    <sys:String x:Key="Profiles.Save">Save profile</sys:String>
    <sys:String x:Key="Profiles.NewItem">(new profile)</sys:String>
    <sys:String x:Key="Profiles.Name">Profile name</sys:String>
    <sys:String x:Key="Profiles.ClientNames">Device names (Moonlight)</sys:String>
    <sys:String x:Key="Profiles.ClientNames.Hint">One per line, as shown in Moonlight. Leave empty for a profile that only acts as the default.</sys:String>
    <sys:String x:Key="Profiles.Resolution">Resolution</sys:String>
    <sys:String x:Key="Profiles.Resolution.Hint">With "Fixed value", write it like this: 1920x1080.</sys:String>
    <sys:String x:Key="Profiles.Fps">FPS limit</sys:String>
    <sys:String x:Key="Profiles.Mode.Follow">Follow the device</sys:String>
    <sys:String x:Key="Profiles.Mode.Fixed">Fixed value</sys:String>
    <sys:String x:Key="Profiles.Mode.Leave">Leave as is</sys:String>
    <sys:String x:Key="Profiles.Hdr.On">HDR on (with "Fixed value")</sys:String>
    <sys:String x:Key="Profiles.Revert">Restore the screen on disconnect (without ending the session)</sys:String>
    <sys:String x:Key="Profiles.Default">Use as the default profile (when no name matches)</sys:String>
    <sys:String x:Key="Profiles.Delay">Launcher delay for this profile (milliseconds)</sys:String>
    <sys:String x:Key="Profiles.Delay.Hint">Empty uses the delay from the General screen. 0 to 30000.</sys:String>
    <sys:String x:Key="Profiles.Saved">Profile saved. Takes effect from the next stream.</sys:String>
    <sys:String x:Key="Profiles.Deleted">Profile deleted.</sys:String>
    <sys:String x:Key="Profiles.DeleteConfirm">Delete the profile "{0}"? This cannot be undone (the file has a daily backup).</sys:String>
    <sys:String x:Key="Profiles.DeleteTitle">Delete profile</sys:String>
    <sys:String x:Key="Profiles.Error.Name">Give the profile a name.</sys:String>
    <sys:String x:Key="Profiles.Error.Resolution">Invalid resolution: use the format 1920x1080.</sys:String>
    <sys:String x:Key="Profiles.Error.Fps">Invalid FPS: use a whole number from 1 to 1000.</sys:String>
    <sys:String x:Key="Profiles.Error.Delay">Invalid delay: leave empty or use a whole number from 0 to 30000.</sys:String>
    <sys:String x:Key="Profiles.Fps.NoPermission">This profile caps FPS, but the app is not yet allowed to write the RTSS profile (it lives in Program Files). Click "Repair": Windows asks for confirmation once and unlocks only that file.</sys:String>
    <sys:String x:Key="Profiles.Fps.Repair">Repair</sys:String>
    <sys:String x:Key="Profiles.Fps.Repairing">Waiting for the Windows confirmation...</sys:String>
    <sys:String x:Key="Profiles.Fps.Repaired">Done: the app can now write the RTSS FPS limit.</sys:String>
    <sys:String x:Key="Profiles.Fps.RepairFailed">Could not grant the permission: {0}</sys:String>
    <sys:String x:Key="Panel.RtssClosed">Warning: this profile caps FPS, but RTSS is not running. The limit only applies once RTSS is open.</sys:String>
    <sys:String x:Key="Controller.Status.None">No controller seen right now.</sys:String>
    <sys:String x:Key="Controller.Status.Connected">Controller connected.</sys:String>
    <sys:String x:Key="Controller.Hint">Here you can record the buttons of each combo and try how long to hold. The screen reads an Xbox-style controller (in Sunshine, keep the gamepad option at x360). The time bar is only a test, but if a stream is on and the combo is turned on, holding it to the end really does what the combo does.</sys:String>
    <sys:String x:Key="Controller.CloseGame.Title">Close the game</sys:String>
    <sys:String x:Key="Controller.CloseGame.Hint">Turned on in General. Asks the game in front to close; hold again to end it.</sys:String>
    <sys:String x:Key="Controller.Overlay.Title">Open the overlay</sys:String>
    <sys:String x:Key="Controller.Overlay.Hint">Opens the overlay on the right of the screen during a stream. Today it has Restore now; profiles, adjustments, windows and shortcuts come next.</sys:String>
    <sys:String x:Key="Controller.Record">Record</sys:String>
    <sys:String x:Key="Controller.Record.Cancel">Cancel</sys:String>
    <sys:String x:Key="Controller.Record.Prompt">Hold the buttons of the combo, then let go of everything…</sys:String>
    <sys:String x:Key="Controller.Record.NoController">No controller seen. Connect one (or start a stream) and try again.</sys:String>
    <sys:String x:Key="Controller.Reset">Back to default</sys:String>
    <sys:String x:Key="Controller.Hold">Hold time: {0} s</sys:String>
    <sys:String x:Key="Controller.Hold.Less">−</sys:String>
    <sys:String x:Key="Controller.Hold.More">+</sys:String>
    <sys:String x:Key="Controller.Hold.Idle">Hold exactly these buttons to try the time.</sys:String>
    <sys:String x:Key="Controller.Hold.Reached">Done: that is how long it takes.</sys:String>
    <sys:String x:Key="Controller.Saved">Saved: {0}. It applies right away.</sys:String>
    <sys:String x:Key="Controller.NotSaved">Not saved:</sys:String>
    <sys:String x:Key="Controller.Issue.TooFewButtons">a combo needs at least 2 buttons.</sys:String>
    <sys:String x:Key="Controller.Issue.TooManyButtons">a combo takes at most 4 buttons.</sys:String>
    <sys:String x:Key="Controller.Issue.StartAndBack">Start and Select together are not allowed (it is also Moonlight's quit shortcut).</sys:String>
    <sys:String x:Key="Controller.Issue.SameAsOther">the other combo already uses these buttons.</sys:String>
    <sys:String x:Key="Controller.Issue.HoldTooShort">the hold time must be at least 0.5 s.</sys:String>
    <sys:String x:Key="Controller.Issue.HoldTooLong">the hold time must be at most 10 s.</sys:String>
