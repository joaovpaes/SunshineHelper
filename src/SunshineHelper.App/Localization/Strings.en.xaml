    <sys:String x:Key="Overlay.Item.Windows.Description">Bring forward, close, end</sys:String>
    <sys:String x:Key="Overlay.Item.Shortcuts">Shortcuts</sys:String>
    <sys:String x:Key="Overlay.Item.Shortcuts.Description">Send keys to the game</sys:String>
    <sys:String x:Key="Overlay.Item.Restore">Restore now</sys:String>
    <sys:String x:Key="Overlay.Item.Restore.Description">Back to how it was before the stream</sys:String>
    <sys:String x:Key="Overlay.Soon">SOON</sys:String>
    <sys:String x:Key="Overlay.Hint.Move">Move</sys:String>
    <sys:String x:Key="Overlay.Hint.Select">Select</sys:String>
    <sys:String x:Key="Overlay.Hint.Close">Close overlay</sys:String>
    <sys:String x:Key="Overlay.Confirm.Title">Restore everything now?</sys:String>
    <sys:String x:Key="Overlay.Confirm.Text">Resolution, HDR and FPS cap go back to what they were before the stream. The stream goes on, and the launcher stays open. The combos stop until the next stream.</sys:String>
    <sys:String x:Key="Overlay.Confirm.Ok">Restore</sys:String>
    <sys:String x:Key="Overlay.Confirm.Cancel">Cancel</sys:String>
    <sys:String x:Key="Overlay.Restoring">Restoring…</sys:String>
    <sys:String x:Key="Overlay.Restored">Done: resolution, HDR and FPS cap are back to what they were before the stream.</sys:String>
    <sys:String x:Key="Overlay.RestoreFailed">Could not restore everything: {0}</sys:String>
    <sys:String x:Key="Controller.Overlay.Enable">Open the overlay by holding this combo during a stream</sys:String>
    <sys:String x:Key="Controller.Overlay.TakeFocus">Take the focus from the game when the overlay opens, and give it back when it closes</sys:String>
    <sys:String x:Key="Controller.Overlay.TakeFocus.Hint">If Windows refuses to switch the focus, the overlay works anyway, but the game may also receive the buttons. Turn this off to keep the game in front.</sys:String>
</ResourceDictionary>
