    <sys:String x:Key="Overlay.Title">Overlay</sys:String>
    <sys:String x:Key="Overlay.Subtitle">Controlled from the controller.</sys:String>
    <sys:String x:Key="Overlay.Status.Streaming">Streaming now</sys:String>
    <sys:String x:Key="Overlay.Status.ClientAndProfile">Streaming to {0} · profile {1}</sys:String>
    <sys:String x:Key="Overlay.Status.Profile">Streaming · profile {0}</sys:String>
    <sys:String x:Key="Overlay.Status.Restored">Environment restored · the stream goes on</sys:String>
    <sys:String x:Key="Overlay.Item.Profiles">Profiles</sys:String>
    <sys:String x:Key="Overlay.Item.Profiles.Description">Switch profile now</sys:String>
    <sys:String x:Key="Overlay.Item.Adjust">Adjustments</sys:String>
    <sys:String x:Key="Overlay.Item.Adjust.Description">Resolution, HDR and FPS</sys:String>
