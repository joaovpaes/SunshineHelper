<Window x:Class="SunshineHelper.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunshineHelper"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <!-- The overlay is always dark, whatever the app's theme (docs/adr/0015-overlay-pelo-controle.md).
         Its colors are fixed in OverlayWindow.xaml.cs. The panel is built in code from OverlayModel. -->
    <Grid>
        <Border x:Name="Scrim" Background="#8C05070B" />
        <Border x:Name="PanelBorder" HorizontalAlignment="Right" Background="#05070B"
                BorderBrush="#232B3A" BorderThickness="1,0,0,0">
            <Grid>
                <StackPanel x:Name="PanelHost" />
                <Border x:Name="ConfirmLayer" Background="#D105070B" Visibility="Collapsed">
                    <Border x:Name="ConfirmCard" VerticalAlignment="Center" Margin="28" Padding="28"
                            Background="#10151F" BorderBrush="#232B3A" BorderThickness="1" CornerRadius="12" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
