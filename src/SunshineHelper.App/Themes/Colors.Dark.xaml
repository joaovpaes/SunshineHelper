<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sinal design system, dark theme (docs/adr/0005-casca-da-interface.md). Same keys as
         Colors.Light.xaml: swapping the dictionary re-themes every DynamicResource. The
         Color.* names are also read by the contrast test in SunshineHelper.Domain.Tests. -->

    <Color x:Key="Color.Window">#05070B</Color>
    <Color x:Key="Color.Band">#0A0E15</Color>
    <Color x:Key="Color.Panel">#10151F</Color>
    <Color x:Key="Color.PanelRaised">#161C28</Color>
    <Color x:Key="Color.Line">#232B3A</Color>
    <Color x:Key="Color.Text">#E8ECF4</Color>
    <Color x:Key="Color.TextDim">#98A2B5</Color>
    <Color x:Key="Color.TextMute">#5E6A80</Color>
    <Color x:Key="Color.AccentFocus">#5A97FF</Color>
    <Color x:Key="Color.Accent">#2F7BFF</Color>
    <Color x:Key="Color.AccentStrong">#1760E6</Color>
    <Color x:Key="Color.AccentTint">#082554</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Ok">#3DDC97</Color>
    <Color x:Key="Color.Warn">#FFB020</Color>
    <Color x:Key="Color.Danger">#FF5C6C</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Band" Color="{StaticResource Color.Band}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.TextMute" Color="{StaticResource Color.TextMute}" />
    <SolidColorBrush x:Key="Brush.AccentFocus" Color="{StaticResource Color.AccentFocus}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentTint" Color="{StaticResource Color.AccentTint}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
</ResourceDictionary>
