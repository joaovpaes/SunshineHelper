<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sinal: spacing, shape, type scale and motion (docs/adr/0005-casca-da-interface.md).
         Theme-independent, so loaded once and never swapped. -->

    <!-- 4 px grid -->
    <x:Double x:Key="Space.1">4</x:Double>
    <x:Double x:Key="Space.2">8</x:Double>
    <x:Double x:Key="Space.3">12</x:Double>
    <x:Double x:Key="Space.4">16</x:Double>
    <x:Double x:Key="Space.6">24</x:Double>
    <x:Double x:Key="Space.8">32</x:Double>
    <x:Double x:Key="Space.12">48</x:Double>

    <!-- Small radii only: flat surfaces, 1 px lines -->
    <CornerRadius x:Key="Radius.Small">2</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">4</CornerRadius>
    <CornerRadius x:Key="Radius.Large">8</CornerRadius>

    <!-- Type. Hanken Grotesk and JetBrains Mono are the design's faces; they are not
         bundled yet (a later PR adds the font files), so these fall back to what Windows 11
         ships. Swapping them in is a change to these two lines only. -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <x:Double x:Key="FontSize.Caption">12</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Subtitle">16</x:Double>
    <x:Double x:Key="FontSize.Title">20</x:Double>
    <x:Double x:Key="FontSize.Heading">28</x:Double>
    <x:Double x:Key="FontSize.Display">40</x:Double>

    <!-- Motion: response, panel entry, screen change. Consumers must skip these when
         Windows "Reduce animations" is on (SystemParameters.ClientAreaAnimation). -->
    <Duration x:Key="Motion.Response">0:0:0.120</Duration>
    <Duration x:Key="Motion.Panel">0:0:0.200</Duration>
    <Duration x:Key="Motion.Screen">0:0:0.320</Duration>
    <KeySpline x:Key="Motion.Curve">0.2,0,0,1</KeySpline>
</ResourceDictionary>
