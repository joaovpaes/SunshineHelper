<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Windows-only: this is where CsWin32, RTSS integration, the Sunshine log
         reader and the named-pipe channel will live. -->
    <!-- Several Win32 entry points take raw pointers that no managed signature can
         stand in for — ChangeDisplaySettingsEx takes a DEVMODEW* precisely because
         Win32 lets it be null. Only the call sites that need it are marked unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SunshineHelper.Application\SunshineHelper.Application.csproj" />
    <ProjectReference Include="..\SunshineHelper.Protocol\SunshineHelper.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source generator: turns NativeMethods.txt into the P/Invoke signatures and
         structs it names, generated at build time from Microsoft's own Win32 metadata.
         No runtime assembly of its own. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <!-- No package is needed for the named-pipe ACL: PipeSecurity, PipeAccessRule and
       NamedPipeServerStreamAcl live in the System.IO.Pipes *namespace* and ship with the
       framework on a -windows TFM. "System.IO.Pipes.AccessControl" is the name of the
       assembly (and of an old compat package), not of a namespace — referencing that
       package here only earns NU1510. -->

</Project>
