* text=auto eol=lf

*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xaml    text eol=lf
*.editorconfig text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Windows-only files that must stay CRLF
*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch
*.png binary
*.ico binary
*.exe binary
*.zip binary
